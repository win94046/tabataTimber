-- WorkoutSession table for storing completed workout sessions
CREATE TABLE workout_sessions (
    id TEXT PRIMARY KEY NOT NULL,
    configuration_id TEXT NOT NULL,
    start_time INTEGER NOT NULL,  -- Timestamp as seconds since epoch
    end_time INTEGER,  -- Timestamp as seconds since epoch (NULL if not completed)
    total_duration INTEGER,  -- Total duration in seconds (calculated when completed)
    completed_cycles INTEGER NOT NULL DEFAULT 0,
    completed_sets INTEGER NOT NULL DEFAULT 0,
    is_completed INTEGER NOT NULL DEFAULT 0,  -- Boolean as INTEGER (0/1)
    completion_percentage REAL NOT NULL DEFAULT 0.0 CHECK (completion_percentage >= 0.0 AND completion_percentage <= 100.0),
    calories_burned INTEGER DEFAULT 0,  -- Optional estimated calories burned
    heart_rate_avg INTEGER DEFAULT 0,  -- Optional average heart rate
    heart_rate_max INTEGER DEFAULT 0,  -- Optional maximum heart rate
    rating INTEGER DEFAULT 0 CHECK (rating >= 0 AND rating <= 5),  -- User rating 1-5 stars
    notes TEXT DEFAULT '',  -- Optional user notes
    created_at INTEGER NOT NULL,  -- Timestamp as seconds since epoch
    
    -- Foreign key constraint (will be enforced by application logic since SQLite FK support is limited)
    -- FOREIGN KEY (configuration_id) REFERENCES timer_configurations(id)
    
    -- Ensure logical data integrity
    CHECK (start_time > 0),
    CHECK (end_time IS NULL OR end_time >= start_time),
    CHECK (total_duration IS NULL OR total_duration >= 0),
    CHECK (completed_cycles >= 0),
    CHECK (completed_sets >= 0),
    CHECK (calories_burned >= 0),
    CHECK (heart_rate_avg >= 0 AND heart_rate_avg <= 300),
    CHECK (heart_rate_max >= 0 AND heart_rate_max <= 300),
    CHECK (heart_rate_max >= heart_rate_avg OR heart_rate_max = 0 OR heart_rate_avg = 0)
);

-- Create indexes for better query performance
CREATE INDEX idx_workout_sessions_start_time ON workout_sessions(start_time DESC);
CREATE INDEX idx_workout_sessions_config_id ON workout_sessions(configuration_id);
CREATE INDEX idx_workout_sessions_completed ON workout_sessions(is_completed, start_time DESC);
CREATE INDEX idx_workout_sessions_completion_date ON workout_sessions(DATE(start_time, 'unixepoch'));

-- Queries for workout sessions
selectAll:
SELECT * FROM workout_sessions ORDER BY start_time DESC;

selectById:
SELECT * FROM workout_sessions WHERE id = ?;

selectByConfigurationId:
SELECT * FROM workout_sessions WHERE configuration_id = ? ORDER BY start_time DESC;

selectCompleted:
SELECT * FROM workout_sessions WHERE is_completed = 1 ORDER BY start_time DESC;

selectByDateRange:
SELECT * FROM workout_sessions 
WHERE start_time >= ? AND start_time <= ? 
ORDER BY start_time DESC;

selectRecentWorkouts:
SELECT * FROM workout_sessions 
ORDER BY start_time DESC 
LIMIT ?;

selectWorkoutStats:
SELECT 
    COUNT(*) as total_workouts,
    COUNT(CASE WHEN is_completed = 1 THEN 1 END) as completed_workouts,
    SUM(total_duration) as total_duration,
    AVG(completion_percentage) as avg_completion_percentage,
    SUM(calories_burned) as total_calories_burned,
    AVG(rating) as avg_rating
FROM workout_sessions;

selectWeeklyStats:
SELECT 
    DATE(start_time, 'unixepoch', 'weekday 0', '-7 days') as week_start,
    COUNT(*) as workout_count,
    SUM(total_duration) as total_duration,
    AVG(completion_percentage) as avg_completion_percentage,
    SUM(calories_burned) as total_calories_burned
FROM workout_sessions 
WHERE start_time >= ? 
GROUP BY DATE(start_time, 'unixepoch', 'weekday 0', '-7 days')
ORDER BY week_start DESC;

selectMonthlyStats:
SELECT 
    strftime('%Y-%m', start_time, 'unixepoch') as month,
    COUNT(*) as workout_count,
    SUM(total_duration) as total_duration,
    AVG(completion_percentage) as avg_completion_percentage,
    SUM(calories_burned) as total_calories_burned
FROM workout_sessions 
WHERE start_time >= ?
GROUP BY strftime('%Y-%m', start_time, 'unixepoch')
ORDER BY month DESC;

insertSession:
INSERT INTO workout_sessions (
    id, configuration_id, start_time, end_time, total_duration,
    completed_cycles, completed_sets, is_completed, completion_percentage,
    calories_burned, heart_rate_avg, heart_rate_max, rating, notes, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSession:
UPDATE workout_sessions 
SET end_time = ?, total_duration = ?, completed_cycles = ?, completed_sets = ?,
    is_completed = ?, completion_percentage = ?, calories_burned = ?,
    heart_rate_avg = ?, heart_rate_max = ?, rating = ?, notes = ?
WHERE id = ?;

updateSessionProgress:
UPDATE workout_sessions 
SET completed_cycles = ?, completed_sets = ?, completion_percentage = ?
WHERE id = ?;

completeSession:
UPDATE workout_sessions 
SET end_time = ?, total_duration = ?, is_completed = 1, completion_percentage = 100.0
WHERE id = ?;

deleteSession:
DELETE FROM workout_sessions WHERE id = ?;

deleteOldSessions:
DELETE FROM workout_sessions WHERE start_time < ?;

-- Get workout streak (consecutive days with at least one workout)
selectWorkoutStreak:
WITH RECURSIVE workout_dates AS (
    SELECT DISTINCT DATE(start_time, 'unixepoch') as workout_date
    FROM workout_sessions
    WHERE is_completed = 1
    ORDER BY workout_date DESC
),
date_series AS (
    SELECT 
        workout_date,
        ROW_NUMBER() OVER (ORDER BY workout_date DESC) as rn,
        DATE('now') as today
    FROM workout_dates
),
consecutive_days AS (
    SELECT 
        workout_date,
        rn,
        DATE(today, '-' || (rn - 1) || ' days') as expected_date
    FROM date_series
    WHERE workout_date = expected_date OR (rn = 1 AND workout_date = DATE('now', '-1 day'))
)
SELECT COUNT(*) as streak_days FROM consecutive_days;