-- WeightEntry table for storing weight measurements and body composition data
CREATE TABLE weight_entries (
    id TEXT PRIMARY KEY NOT NULL,
    weight REAL NOT NULL CHECK (weight > 0 AND weight <= 1000),  -- Weight in the specified unit
    unit TEXT NOT NULL CHECK (unit IN ('KG', 'LB', 'ST')),  -- Weight unit
    weight_kg REAL NOT NULL CHECK (weight_kg >= 1.0 AND weight_kg <= 1000.0),  -- Weight converted to kg for calculations
    date_recorded TEXT NOT NULL,  -- ISO date format (YYYY-MM-DD)
    time_recorded INTEGER NOT NULL,  -- Timestamp as seconds since epoch
    notes TEXT DEFAULT '',
    
    -- Optional body composition data
    body_fat_percentage REAL CHECK (body_fat_percentage IS NULL OR (body_fat_percentage >= 0.0 AND body_fat_percentage <= 100.0)),
    muscle_mass REAL CHECK (muscle_mass IS NULL OR (muscle_mass >= 0.0 AND muscle_mass <= weight_kg)),
    water_percentage REAL CHECK (water_percentage IS NULL OR (water_percentage >= 0.0 AND water_percentage <= 100.0)),
    visceral_fat REAL CHECK (visceral_fat IS NULL OR (visceral_fat >= 0.0 AND visceral_fat <= 60.0)),
    bone_mass REAL CHECK (bone_mass IS NULL OR (bone_mass >= 0.0 AND bone_mass <= weight_kg * 0.3)),
    
    -- Measurement source
    source TEXT NOT NULL DEFAULT 'MANUAL' CHECK (source IN ('MANUAL', 'SMART_SCALE', 'FITNESS_APP', 'HEALTH_APP', 'IMPORT')),
    
    created_at INTEGER NOT NULL,  -- Timestamp as seconds since epoch
    
    -- Additional validation constraints
    CHECK (time_recorded > 0),
    CHECK (length(date_recorded) = 10),  -- YYYY-MM-DD format
    CHECK (muscle_mass IS NULL OR body_fat_percentage IS NULL OR (muscle_mass + (weight_kg * body_fat_percentage / 100.0) <= weight_kg))
);

-- Create indexes for better query performance
CREATE INDEX idx_weight_entries_date ON weight_entries(date_recorded DESC);
CREATE INDEX idx_weight_entries_time ON weight_entries(time_recorded DESC);
CREATE INDEX idx_weight_entries_created ON weight_entries(created_at DESC);
CREATE INDEX idx_weight_entries_source ON weight_entries(source);

-- User profile table for storing height and other static health data
CREATE TABLE user_profile (
    id INTEGER PRIMARY KEY CHECK (id = 1),  -- Ensure single row
    height_cm REAL CHECK (height_cm IS NULL OR (height_cm >= 50.0 AND height_cm <= 300.0)),  -- Height in centimeters
    birth_date TEXT,  -- ISO date format (YYYY-MM-DD) 
    gender TEXT CHECK (gender IS NULL OR gender IN ('MALE', 'FEMALE', 'OTHER')),
    activity_level TEXT DEFAULT 'MODERATE' CHECK (activity_level IN ('SEDENTARY', 'LIGHT', 'MODERATE', 'ACTIVE', 'VERY_ACTIVE')),
    target_weight_kg REAL CHECK (target_weight_kg IS NULL OR (target_weight_kg >= 1.0 AND target_weight_kg <= 1000.0)),
    preferred_unit TEXT NOT NULL DEFAULT 'KG' CHECK (preferred_unit IN ('KG', 'LB', 'ST')),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Insert default user profile
INSERT OR IGNORE INTO user_profile (id, created_at, updated_at) 
VALUES (1, 1704067200, 1704067200);

-- Queries for weight entries
selectAll:
SELECT * FROM weight_entries ORDER BY time_recorded DESC;

selectById:
SELECT * FROM weight_entries WHERE id = ?;

selectByDateRange:
SELECT * FROM weight_entries 
WHERE date_recorded >= ? AND date_recorded <= ? 
ORDER BY time_recorded ASC;

selectRecent:
SELECT * FROM weight_entries 
ORDER BY time_recorded DESC 
LIMIT ?;

selectLatest:
SELECT * FROM weight_entries 
ORDER BY time_recorded DESC 
LIMIT 1;

selectByMonth:
SELECT * FROM weight_entries 
WHERE strftime('%Y-%m', date_recorded) = ?
ORDER BY time_recorded ASC;

selectByYear:
SELECT * FROM weight_entries 
WHERE strftime('%Y', date_recorded) = ?
ORDER BY time_recorded ASC;

-- Weight statistics and trends
selectWeightStats:
SELECT 
    COUNT(*) as total_entries,
    MIN(weight_kg) as min_weight,
    MAX(weight_kg) as max_weight,
    AVG(weight_kg) as avg_weight,
    (MAX(weight_kg) - MIN(weight_kg)) as weight_range
FROM weight_entries;

selectWeightTrend:
SELECT 
    date_recorded,
    weight_kg,
    LAG(weight_kg, 1) OVER (ORDER BY time_recorded) as previous_weight,
    weight_kg - LAG(weight_kg, 1) OVER (ORDER BY time_recorded) as weight_change
FROM weight_entries 
ORDER BY time_recorded ASC;

selectMonthlyAverages:
SELECT 
    strftime('%Y-%m', date_recorded) as month,
    AVG(weight_kg) as avg_weight,
    MIN(weight_kg) as min_weight,
    MAX(weight_kg) as max_weight,
    COUNT(*) as entry_count
FROM weight_entries 
GROUP BY strftime('%Y-%m', date_recorded)
ORDER BY month DESC;

selectWeeklyProgress:
SELECT 
    DATE(time_recorded, 'unixepoch', 'weekday 0', '-7 days') as week_start,
    AVG(weight_kg) as avg_weight,
    MIN(weight_kg) as min_weight,
    MAX(weight_kg) as max_weight,
    COUNT(*) as entry_count
FROM weight_entries 
WHERE time_recorded >= ?
GROUP BY DATE(time_recorded, 'unixepoch', 'weekday 0', '-7 days')
ORDER BY week_start DESC;

-- Body composition queries
selectWithBodyComposition:
SELECT * FROM weight_entries 
WHERE body_fat_percentage IS NOT NULL OR muscle_mass IS NOT NULL 
ORDER BY time_recorded DESC;

selectBodyCompositionTrend:
SELECT 
    date_recorded,
    weight_kg,
    body_fat_percentage,
    muscle_mass,
    water_percentage,
    visceral_fat,
    bone_mass
FROM weight_entries 
WHERE body_fat_percentage IS NOT NULL OR muscle_mass IS NOT NULL
ORDER BY time_recorded ASC;

-- User profile queries
selectUserProfile:
SELECT * FROM user_profile WHERE id = 1;

updateUserProfile:
UPDATE user_profile 
SET height_cm = ?, birth_date = ?, gender = ?, activity_level = ?, 
    target_weight_kg = ?, preferred_unit = ?, updated_at = ?
WHERE id = 1;

-- BMI calculation query (requires height from user profile)
selectBMIData:
SELECT 
    we.id,
    we.date_recorded,
    we.weight_kg,
    up.height_cm,
    CASE 
        WHEN up.height_cm IS NOT NULL AND up.height_cm > 0 THEN 
            we.weight_kg / ((up.height_cm / 100.0) * (up.height_cm / 100.0))
        ELSE NULL 
    END as bmi
FROM weight_entries we
CROSS JOIN user_profile up
WHERE up.id = 1
ORDER BY we.time_recorded DESC;

-- CRUD operations for weight entries
insertWeightEntry:
INSERT INTO weight_entries (
    id, weight, unit, weight_kg, date_recorded, time_recorded, notes,
    body_fat_percentage, muscle_mass, water_percentage, visceral_fat, bone_mass,
    source, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateWeightEntry:
UPDATE weight_entries 
SET weight = ?, unit = ?, weight_kg = ?, date_recorded = ?, time_recorded = ?,
    notes = ?, body_fat_percentage = ?, muscle_mass = ?, water_percentage = ?,
    visceral_fat = ?, bone_mass = ?, source = ?
WHERE id = ?;

deleteWeightEntry:
DELETE FROM weight_entries WHERE id = ?;

deleteOldEntries:
DELETE FROM weight_entries WHERE time_recorded < ?;

-- Utility queries
countEntriesInDateRange:
SELECT COUNT(*) FROM weight_entries 
WHERE date_recorded >= ? AND date_recorded <= ?;