-- SubscriptionData table for storing subscription status and history
CREATE TABLE subscription_data (
    id INTEGER PRIMARY KEY CHECK (id = 1),  -- Ensure single row for current subscription
    subscription_type TEXT NOT NULL CHECK (subscription_type IN ('FREE', 'PREMIUM', 'TRIAL', 'EXPIRED', 'CANCELLED', 'PAYMENT_FAILED')),
    
    -- Common fields
    current_status TEXT NOT NULL DEFAULT 'FREE',
    
    -- Free tier data
    trial_used INTEGER NOT NULL DEFAULT 0,  -- Boolean: has user used trial
    trial_end_date INTEGER,  -- Timestamp when trial ended
    
    -- Premium subscription data
    subscription_id TEXT,  -- External subscription ID
    plan_id TEXT,  -- Plan identifier
    start_date INTEGER,  -- Subscription start timestamp
    expiry_date INTEGER,  -- Subscription expiry timestamp
    auto_renew INTEGER DEFAULT 1,  -- Boolean: auto renewal enabled
    payment_provider TEXT CHECK (payment_provider IS NULL OR payment_provider IN ('GOOGLE_PLAY', 'APP_STORE', 'STRIPE', 'UNKNOWN')),
    
    -- Trial subscription data
    trial_id TEXT,  -- Trial identifier
    trial_start_date INTEGER,  -- Trial start timestamp
    trial_expiry_date INTEGER,  -- Trial expiry timestamp
    original_plan_id TEXT,  -- Original plan that trial is for
    
    -- Expired subscription data
    last_subscription_id TEXT,  -- Last active subscription ID
    last_plan_id TEXT,  -- Last active plan ID
    last_expiry_date INTEGER,  -- When subscription last expired
    grace_period_end_date INTEGER,  -- Grace period end timestamp
    
    -- Cancelled subscription data
    cancellation_date INTEGER,  -- When subscription was cancelled
    cancellation_reason TEXT CHECK (cancellation_reason IS NULL OR cancellation_reason IN ('USER_CANCELLED', 'PAYMENT_FAILED', 'REFUND_REQUESTED', 'POLICY_VIOLATION', 'OTHER')),
    
    -- Payment failed data
    last_successful_payment INTEGER,  -- Last successful payment timestamp
    next_retry_date INTEGER,  -- Next payment retry timestamp
    retry_count INTEGER DEFAULT 0,  -- Number of payment retries
    max_retries INTEGER DEFAULT 3,  -- Maximum retry attempts
    
    -- Tracking fields
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    
    -- Data integrity constraints
    CHECK (subscription_type = 'FREE' OR subscription_id IS NOT NULL OR trial_id IS NOT NULL),
    CHECK (expiry_date IS NULL OR expiry_date > start_date),
    CHECK (trial_expiry_date IS NULL OR trial_expiry_date > trial_start_date),
    CHECK (grace_period_end_date IS NULL OR grace_period_end_date >= last_expiry_date),
    CHECK (retry_count >= 0 AND retry_count <= max_retries)
);

-- Feature usage tracking table
CREATE TABLE feature_usage (
    feature_name TEXT PRIMARY KEY NOT NULL,
    usage_count INTEGER NOT NULL DEFAULT 0 CHECK (usage_count >= 0),
    daily_usage_count INTEGER NOT NULL DEFAULT 0 CHECK (daily_usage_count >= 0),
    last_used_date TEXT,  -- ISO date format (YYYY-MM-DD)
    last_reset_date TEXT,  -- ISO date format when daily counter was reset
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Subscription history table for audit trail
CREATE TABLE subscription_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    subscription_type TEXT NOT NULL,
    subscription_id TEXT,
    plan_id TEXT,
    action TEXT NOT NULL CHECK (action IN ('CREATED', 'RENEWED', 'UPGRADED', 'DOWNGRADED', 'CANCELLED', 'EXPIRED', 'TRIAL_STARTED', 'TRIAL_ENDED', 'PAYMENT_FAILED', 'PAYMENT_RECOVERED')),
    details TEXT,  -- JSON or additional details about the action
    timestamp INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

-- Insert default subscription data (free tier)
INSERT OR IGNORE INTO subscription_data (
    id, subscription_type, current_status, created_at, updated_at
) VALUES (1, 'FREE', 'FREE', 1704067200, 1704067200);

-- Initialize common premium features usage tracking
INSERT OR IGNORE INTO feature_usage (feature_name, created_at, updated_at) VALUES
    ('UNLIMITED_PRESETS', 1704067200, 1704067200),
    ('ADVANCED_STATISTICS', 1704067200, 1704067200),
    ('CLOUD_SYNC', 1704067200, 1704067200),
