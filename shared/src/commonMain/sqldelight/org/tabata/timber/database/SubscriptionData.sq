    ('WORKOUT_REMINDERS', 1704067200, 1704067200);

-- Create indexes for better performance
CREATE INDEX idx_subscription_history_timestamp ON subscription_history(timestamp DESC);
CREATE INDEX idx_subscription_history_type ON subscription_history(subscription_type);
CREATE INDEX idx_feature_usage_date ON feature_usage(last_used_date);

-- Queries for subscription data
selectCurrentSubscription:
SELECT * FROM subscription_data WHERE id = 1;

selectSubscriptionHistory:
SELECT * FROM subscription_history ORDER BY timestamp DESC;

selectSubscriptionHistoryByType:
SELECT * FROM subscription_history 
WHERE subscription_type = ? 
ORDER BY timestamp DESC;

selectRecentSubscriptionHistory:
SELECT * FROM subscription_history 
ORDER BY timestamp DESC 
LIMIT ?;

-- Feature usage queries
selectAllFeatureUsage:
SELECT * FROM feature_usage ORDER BY feature_name ASC;

selectFeatureUsage:
SELECT * FROM feature_usage WHERE feature_name = ?;

selectFeaturesUsedToday:
SELECT * FROM feature_usage 
WHERE last_used_date = DATE('now') 
ORDER BY feature_name ASC;

selectMostUsedFeatures:
SELECT * FROM feature_usage 
ORDER BY usage_count DESC 
LIMIT ?;

-- Subscription management operations
updateSubscriptionToFree:
UPDATE subscription_data 
SET subscription_type = 'FREE',
    current_status = 'FREE',
    subscription_id = NULL,
    plan_id = NULL,
    start_date = NULL,
    expiry_date = NULL,
    updated_at = ?
WHERE id = 1;

updateSubscriptionToPremium:
UPDATE subscription_data 
SET subscription_type = 'PREMIUM',
    current_status = 'PREMIUM',
    subscription_id = ?,
    plan_id = ?,
    start_date = ?,
    expiry_date = ?,
    auto_renew = ?,
    payment_provider = ?,
    updated_at = ?
WHERE id = 1;

updateSubscriptionToTrial:
UPDATE subscription_data 
SET subscription_type = 'TRIAL',
    current_status = 'TRIAL',
    trial_used = 1,
    trial_id = ?,
    trial_start_date = ?,
    trial_expiry_date = ?,
    original_plan_id = ?,
    updated_at = ?
WHERE id = 1;

updateSubscriptionToExpired:
UPDATE subscription_data 
SET subscription_type = 'EXPIRED',
    current_status = 'EXPIRED',
    last_subscription_id = subscription_id,
    last_plan_id = plan_id,
    last_expiry_date = expiry_date,
    grace_period_end_date = ?,
    updated_at = ?
WHERE id = 1;

updateSubscriptionToCancelled:
UPDATE subscription_data 
SET subscription_type = 'CANCELLED',
    current_status = 'CANCELLED',
    cancellation_date = ?,
    cancellation_reason = ?,
    auto_renew = 0,
    updated_at = ?
WHERE id = 1;

updateSubscriptionToPaymentFailed:
UPDATE subscription_data 
SET subscription_type = 'PAYMENT_FAILED',
    current_status = 'PAYMENT_FAILED',
    last_successful_payment = ?,
    next_retry_date = ?,
    retry_count = ?,
    updated_at = ?
WHERE id = 1;

-- Feature usage operations
incrementFeatureUsage:
UPDATE feature_usage 
SET usage_count = usage_count + 1,
    daily_usage_count = daily_usage_count + 1,
    last_used_date = DATE('now'),
    updated_at = ?
WHERE feature_name = ?;

resetDailyFeatureUsage:
UPDATE feature_usage 
SET daily_usage_count = 0,
    last_reset_date = DATE('now'),
    updated_at = ?
WHERE feature_name = ?;

resetAllDailyFeatureUsage:
UPDATE feature_usage 
SET daily_usage_count = 0,
    last_reset_date = DATE('now'),
    updated_at = ?;

-- Subscription history operations
insertSubscriptionHistory:
INSERT INTO subscription_history (
    subscription_type, subscription_id, plan_id, action, details, timestamp, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

-- Utility queries
checkPremiumAccess:
SELECT 
    subscription_type,
    current_status,
    CASE 
        WHEN subscription_type = 'FREE' THEN 0
        WHEN subscription_type = 'PREMIUM' AND expiry_date > ? THEN 1
        WHEN subscription_type = 'TRIAL' AND trial_expiry_date > ? THEN 1
        WHEN subscription_type = 'EXPIRED' AND grace_period_end_date > ? THEN 1
        WHEN subscription_type = 'CANCELLED' AND expiry_date > ? THEN 1
        WHEN subscription_type = 'PAYMENT_FAILED' THEN 1
        ELSE 0
    END as has_premium_access
FROM subscription_data WHERE id = 1;

checkTrialEligibility:
SELECT 
    CASE 
        WHEN trial_used = 0 THEN 1
        ELSE 0
    END as trial_eligible
FROM subscription_data WHERE id = 1;

getSubscriptionSummary:
SELECT 
    subscription_type,
    current_status,
    subscription_id,
    plan_id,
    start_date,
    expiry_date,
    trial_used,
    trial_expiry_date,
    auto_renew,
    payment_provider,
    cancellation_reason
FROM subscription_data WHERE id = 1;

-- Clean up old history entries (keep last N entries)
deleteOldSubscriptionHistory:
DELETE FROM subscription_history 
WHERE id NOT IN (
    SELECT id FROM subscription_history 
    ORDER BY timestamp DESC 
    LIMIT ?
);