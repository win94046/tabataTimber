INSERT OR IGNORE INTO user_stats_summary (id, last_updated) 
VALUES (1, 1704067200);

-- Update template categories for existing presets
UPDATE timer_configurations 
SET template_category = 'OFFICIAL',
    difficulty_level = CASE 
        WHEN id = 'preset_beginner' THEN 1
        WHEN id = 'preset_standard' THEN 3
        WHEN id = 'preset_advanced' THEN 5
        ELSE 1
    END,
    estimated_calories = CASE 
        WHEN id = 'preset_beginner' THEN 80
        WHEN id = 'preset_standard' THEN 120
        WHEN id = 'preset_advanced' THEN 200
        ELSE 0
    END
WHERE is_preset = 1;